# /etc/nginx/sites-available/sglci.sajholding.org
server {
    listen 80;
    server_name sglci.sajholding.org;

    # Redirect HTTP to HTTPS (optional now, mandatory after cert is issued)
    # return 301 https://$host$request_uri;

    location /static/ {
        alias /home/herve/loqt/staticfiles/;
        # Add far-future headers for static
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location /media/ {
        alias /home/herve/loqt/media/;
    }

    location / {
        include proxy_params;
        proxy_pass http://unix:/run/gunicorn-loqt.sock;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
