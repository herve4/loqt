# ===================================
# Configuration de la base de données
# ===================================
POSTGRES_DB=loqt
POSTGRES_USER=loqt
POSTGRES_PASSWORD=change_this_secure_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ===================================
# Configuration Django
# ===================================
SECRET_KEY=change_this_to_a_secure_secret_key
DEBUG=0
ALLOWED_HOSTS=localhost,127.0.0.1

# URL de la base de données (format: postgres://user:password@host:port/dbname)
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Configuration des e-mails (exemple pour développement)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=webmaster@loqt.local

# ===================================
# Configuration Ngrok
# ===================================
# Obtenez votre token sur https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTH_TOKEN=your_ngrok_auth_token
# Optionnel : Votre sous-domaine personnalisé (doit être configuré dans votre compte Ngrok)
NGROK_DOMAIN=

# ===================================
# Paramètres avancés
# ===================================
# Créer un superutilisateur au démarrage (true/false)
CREATE_SUPERUSER=false

# Configuration du fuseau horaire
TIME_ZONE=Europe/Paris

# Configuration des médias
MEDIA_URL=/media/
MEDIA_ROOT=/app/media/
STATIC_URL=/static/
STATIC_ROOT=/app/staticfiles/

# Configuration de sécurité (à décommenter en production)
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_BROWSER_XSS_FILTER=True
# SECURE_CONTENT_TYPE_NOSNIFF=True
# X_FRAME_OPTIONS=DENY
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True

# ===================================
# Configuration spécifique à l'application
# ===================================
# Ajoutez ici toutes les variables spécifiques à votre application
